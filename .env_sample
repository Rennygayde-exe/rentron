DISCORD_BOT_TOKEN=

# --- Core guild wiring -------------------------------------------------------
HOME_GUILD_ID=
GUILD_ID=
STAFF_ROLE_ID=

# --- Application flow --------------------------------------------------------
STAFF_REVIEW_CHANNEL_ID=
TICKET_CATEGORY_ID=
TICKET_LOG_CHANNEL_ID=
# Greeting posted in a new ticket channel. {user} becomes the opener's mention.
# Used only as a fallback when the variations file below is missing or empty.
TICKET_GREETING_TEXT=
# JSON pool of wordings, one picked at random per ticket. Defaults to
# data/ticket_greetings.json; edits apply to the next ticket without a restart.
TICKET_GREETINGS_FILE=
# Picture shown under the greeting: an https:// URL, or a path to an image file
# (relative paths resolve against the bot directory). Blank = text only.
TICKET_GREETING_IMAGE=
APPLICATION_FOLLOWUP_CATEGORY_ID=
WELCOME_CHANNEL_ID=
MOTD_FILE=

# Path to the applications SQLite DB. Either name is honoured; leave blank to
# use <repo>/applications.db.
APPLICATIONS_DB_PATH=

# Roles granted / removed on an application decision.
# STRONGLY RECOMMENDED: set these by ID. Without an ID the bot falls back to
# matching by role NAME, which it will refuse to do when the name is ambiguous
# (e.g. "Verified" when both "Verified" and "Verified Staff" exist).
VERIFIED_ROLE_ID=
VERIFIED_ROLE_NAME=Verified
PENDING_ROLE_ID=
PENDING_ROLE_NAME=Pending Application

# Branch roles, granted on approval based on the applicant's branch answer.
ARMY_ROLE_ID=
NAVY_ROLE_ID=
MARINES_ROLE_ID=
AIR_FORCE_ROLE_ID=
COAST_GUARD_ROLE_ID=
SPACE_FORCE_ROLE_ID=
FAMILY_ROLE_ID=

# Screening tunables.
# Accounts younger than this many days are flagged (not blocked) for reviewers.
NEW_ACCOUNT_FLAG_DAYS=30
# Seconds a user must wait between presses of the Apply button.
APPLY_COOLDOWN_SECONDS=60

# --- Local control HTTP API --------------------------------------------------
# Requests must carry `Authorization: Bearer $BOT_CONTROL_TOKEN`. If the token
# is unset the authenticated routes refuse every request (fail closed).
BOT_CONTROL_HOST=127.0.0.1
BOT_CONTROL_PORT=8765
BOT_CONTROL_TOKEN=

# --- Other subsystems --------------------------------------------------------
XP_NOTIFICATION_CHANNEL_ID=
STAFF_ALERT_CHANNEL_ID=
TICKET_WAITING_CHANNEL_ID=
BLACKBIRDLOGS_ID=
USEREXITLOGS=
CONTENT_PRUNE_CHANNEL_ID=
SHELL_ALLOWED_USER_ID=
MODMAIL_TEST_ALLOW_STAFF=
BLACKBIRD_PATH=
PURGE_VIDEO_PATH=
SIGNAL_PHONE_NUMBER=
GITHUB_TOKEN=
GITHUB_GUEST_TOKEN=
GITHUB_REPO=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
REDIRECT_URI=
FLASK_SECRET=
TMHNET_DB_PATH=

# --- Minecraft whitelist bridge ---------------------------------------------
MC_WHITELIST_HOST=127.0.0.1
MC_WHITELIST_PORT=28017
MC_WHITELIST_TOKEN=
